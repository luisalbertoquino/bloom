# ARCHIVO DE EJEMPLO PARA CONFIGURACIÓN DE PRODUCCIÓN
# Copia este archivo como .env en tu servidor de producción y ajusta los valores

APP_NAME=Bloom
APP_ENV=production
APP_KEY=base64:TU_CLAVE_AQUI  # Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://store.invite-art.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos de producción
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bloom_production
DB_USERNAME=tu_usuario_bd
DB_PASSWORD=tu_password_bd

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Configuración de Sesión para PRODUCCIÓN
SESSION_DRIVER=file
SESSION_COOKIE=bloom_session
SESSION_LIFETIME=480  # 8 horas
SESSION_DOMAIN=store.invite-art.com
SESSION_SECURE_COOKIE=true   # TRUE para HTTPS
SESSION_SAME_SITE=lax
SESSION_PARTITIONED=false

# Dominios stateful de Sanctum (para CORS y cookies)
SANCTUM_STATEFUL_DOMAINS=store.invite-art.com

# Configuración de correo (si se usa)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-servidor.com
MAIL_PORT=587
MAIL_USERNAME=tu_usuario_email
MAIL_PASSWORD=tu_password_email
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@invite-art.com"
MAIL_FROM_NAME="${APP_NAME}"
